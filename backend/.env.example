# إعدادات الواجهة الخلفية (Backend) — انسخ هذا الملف إلى .env واملأ القيم
# ===========================================================================

# مفتاح سري لتوقيع رموز JWT — غيّره في الإنتاج إلى قيمة عشوائية طويلة
SECRET_KEY=change-this-to-a-long-random-secret-in-production

# مدة صلاحية رمز الدخول (دقائق) ورمز التجديد (أيام)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# قاعدة البيانات:
#  - للتطوير المحلي (SQLite): sqlite:///./hrms.db
#  - للإنتاج (PostgreSQL):     postgresql+psycopg2://hrms:hrms@db:5432/hrms
DATABASE_URL=sqlite:///./hrms_app.db

# مجلد تخزين الملفات المرفوعة (مستندات، صور السيلفي)
# P1-01 — على الإنتاج: مسار **داخل القرص الدائم** لا داخل صورة الحاوية.
#
# قرص الحاوية يُمحى مع كل نشرة: السجلّ يبقى في القاعدة والملف يختفي،
# فيبدو المستند موجوًدا في ملف الموظف حتى يُضغط زرّ التنزيل.
#
# على Railway: أضف Volume واجعل Mount path = /data، ثم:
#   UPLOAD_DIR=/data/uploads
# ولا تجعله داخل /app — محتوى الصورة هناك يحجب نقطة التركيب.
# راجع docs/DEPLOY_RAILWAY_VOLUME.md، وتحقّق بعد النشر من
# ‎/api/health/deep → checks.storage.persistence.persistent‎
UPLOAD_DIR=./uploads

# أصول الواجهة المسموح لها (CORS) — افصل بينها بفاصلة
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# كلمة المرور الموحّدة لأول دخول (تُجبر التغيير) — تُستخدم عند إنشاء مستخدم جديد
DEFAULT_USER_PASSWORD=Kuwait@2024

# تفعيل المهام المجدولة (المسح اليومي للمستندات المنتهية)
SCHEDULER_ENABLED=true

# واتساب/SMS عبر Twilio (اختياري) — اتركها فارغة لإبقاء الإشعارات داخل التطبيق فقط.
# لتفعيلها فعليًا: أنشئ حسابًا على twilio.com، فعّل رقم SMS ورقم WhatsApp Sender،
# وضع القيم هنا (Account SID + Auth Token من لوحة Twilio مباشرة).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ===========================================================================
# النشر على AWS
# ===========================================================================

# تخزين المرفقات: local = قرص الخادم | s3 = دلو S3
# على AWS يجب أن يكون s3: قرص الحاوية مؤقّت، وكل نشرة تمسح ما رُفع.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=me-south-1
# بادئة داخل الدلو (اختيارية) — تفصل بيئات متعددة في دلو واحد
S3_PREFIX=

# ملاحظة: لا تُوضع مفاتيح AWS هنا. الحاوية تأخذ صلاحيتها من IAM Role
# المرتبط بالمهمة، وboto3 يقرأه تلقائًيا. مفتاح مكتوب في متغيّر بيئة
# يُسرَّب مع كل نسخة من تعريف المهمة ولا ينتهي صلاحيته.
